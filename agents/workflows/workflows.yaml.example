# 워크플로우 메타데이터 설정 파일
# 이 파일은 워크플로우의 메타데이터만 관리합니다 (로직은 Python 코드에 있음)
# 서버 재시작 없이 메타데이터를 변경할 수 있습니다

version: '1.0'
comment: '워크플로우 메타데이터 설정 파일 - Python 코드의 기본값을 오버라이드합니다'

workflows:
  # 출장/휴가 관리 워크플로우
  business_trip_flow:
    category: travel
    description: 출장/휴가 관리 (일정 + 문서 + 이메일)
    priority: 10
    enabled: true
    examples:
      - "다음주 제주 출장 등록"
      - "휴가 신청해줘"
      - "출장 일정 확인"

  # R&D 리서치 워크플로우
  research_flow:
    category: research
    description: 기술 연구 및 리포트 자동화 (특허/논문 검색 + 리포트 + 이메일)
    priority: 10
    enabled: true
    examples:
      - "생성형 AI 특허 조사해줘"
      - "R&D 리포트 작성"

  # 회의 준비 워크플로우
  meeting_flow:
    category: meeting
    description: 스마트 회의 준비 (회의실 + 자료 + 초대 + 간식)
    priority: 10
    enabled: true
    examples:
      - "다음주 월요일 킥오프 회의 준비해줘"
      - "회의 설정"

  # 비활성화 예시
  # old_workflow:
  #   category: deprecated
  #   description: 사용하지 않는 워크플로우
  #   priority: 0
  #   enabled: false
  #   examples: []

# 카테고리별 기본 설정
categories:
  travel:
    priority: 10
  research:
    priority: 8
  meeting:
    priority: 9
  hr:
    priority: 7
  finance:
    priority: 6

